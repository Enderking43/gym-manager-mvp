{
  "name": "gym-manager-mvp",
  "version": "1.0.0",
  "description": "Sistema de gestión para gimnasio — offline, local-first",
  "main": "main.js",
  "author": "Bali Gym Manager",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "better-sqlite3": "^12.9.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.baliherafitness.gymmanager",
    "productName": "Bali Gym Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
